<?php

/**
 * @file
 * YSE Connect Requester module hooks.
 */

declare(strict_types=1);

/**
 * Implements hook_theme().
 */
function yse_connectrequester_theme(): array {
  return [
    'yse_connectrequester_events' => [
      'variables' => [
        'email_audience' => 'YSE',
        'admin_header_bg_color' => '',
        'footer_because' => ' you are a member of the YSE community.',
        'listings' => [],
        'listings_for_audience' => [],
      ],
      'template' => 'yse-connectrequester-events',
    ],
    'html__yse_connectrequester' => [
      'template' => 'html--yse-connectrequester',
      'base hook' => 'html',
    ],
    'page__yse_connectrequester' => [
      'template' => 'page--yse-connectrequester',
      'base hook' => 'page',
    ],
  ];
}

/**
 * Implements hook_preprocess_html().
 *
 * Adds a theme suggestion to strip Drupal chrome on preview routes.
 */
function yse_connectrequester_preprocess_html(array &$variables): void {
  $route_name = \Drupal::routeMatch()->getRouteName();
  if (str_starts_with($route_name, 'yse_connectrequester.preview')) {
    $variables['theme_hook_suggestions'][] = 'html__yse_connectrequester';
  }
}

/**
 * Implements hook_preprocess_page().
 *
 * Adds a theme suggestion to strip region wrappers on preview routes.
 */
function yse_connectrequester_preprocess_page(array &$variables): void {
  $route_name = \Drupal::routeMatch()->getRouteName();
  if (str_starts_with($route_name, 'yse_connectrequester.preview')) {
    $variables['theme_hook_suggestions'][] = 'page__yse_connectrequester';
  }
}
